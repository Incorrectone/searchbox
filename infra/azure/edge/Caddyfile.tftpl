# Edge reverse proxy. Rendered by Terraform on first boot; later changes:
# edit edge/Caddyfile.tftpl, `terraform apply`, then run edge/deploy.sh.
#
# Request flow:
#   Cloudflare --443--> Caddy --+--> /img/<hash>.webp -> Azure Blob (read-only SAS)
#                               +--> /api/*           -> app VM ${app_ip}:8080 (rate-limited there)
#                               +--> everything else  -> Anubis 127.0.0.1:8923 (proof-of-work) -> app VM
#   app VM or Anubis down     --> fallback page (or JSON for /api/*)
#
# Anubis is installed by edge/phase3.sh. On a freshly rebuilt edge VM, run that
# script once: until then, pages show the fallback page and /api/* still works.
{
	# Origin cert is installed manually (Cloudflare Origin CA): no ACME, and
	# we define the :80 site ourselves so probes on port 80 are logged too.
	auto_https off
	default_sni ${site_host}

	servers {
		# Only these addresses may tell us the real client IP (Cloudflare edges).
		# Source: https://www.cloudflare.com/ips/ (re-check occasionally)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(access_log) {
	log {
		output file /var/log/caddy/access.json {
			roll_size 20MiB
			roll_keep 5
			mode 0640 # group caddy may read: Vector (in that group) ships it to the SIEM
		}
		format json
	}
}

http:// {
	import access_log
	redir https://${site_host}{uri} 308
}

https:// {
	import access_log
	log_append request_id {http.request.uuid}
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Thumbnails: only GET/HEAD of exactly <2 hex>/<64 hex>.webp is allowed,
	# so the read token can't be used to fetch anything else.
	@thumb {
		method GET HEAD
		path_regexp ^/img/[0-9a-f]{2}/[0-9a-f]{64}\.webp$
	}
	handle @thumb {
		# One rewrite, built from the path segments (/img/<2hex>/<64hex>.webp):
		# Caddy sorts `rewrite` before `uri`, so a separate `uri strip_prefix`
		# would run second and leave /thumbs/img/... (Azure: 404).
		rewrite * /thumbs/{http.request.uri.path.1}/{http.request.uri.path.2}?${read_sas}
		reverse_proxy https://${blob_host} {
			header_up -Cookie
			header_up -Authorization
			header_down -x-ms-*
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down Content-Type image/webp
			# Errors must never get the year-long cache above, or a temporary
			# failure is cached by Cloudflare and browsers for a year.
			@failed status 4xx 5xx
			handle_response @failed {
				header Cache-Control "no-store"
				respond 404
			}
		}
	}
	handle /img/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy ${app_ip}:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		# Pages go through Anubis, which challenges first and then proxies to the app.
		reverse_proxy 127.0.0.1:8923 {
			# Anubis reads the visitor's IP from X-Real-Ip (and binds its cookie to it).
			header_up X-Real-Ip {client_ip}
			header_up X-Forwarded-For {client_ip}
			# If the app VM is down, Anubis answers 502 itself; Caddy's handle_errors
			# only sees Caddy's own failures, so catch Anubis' response here too.
			@down status 502 503 504
			handle_response @down {
				root * /srv/fallback
				rewrite * /index.html
				file_server
			}
		}
	}

	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"error":"app tier offline"}` 503
		}
		handle {
			root * /srv/fallback
			rewrite * /index.html
			file_server
		}
	}
}
