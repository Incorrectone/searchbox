# Edge reverse proxy (Phase 2). Rendered by Terraform on first boot; later
# changes: edit edge/Caddyfile.tftpl and run edge/deploy.sh.
#
# Request flow:
#   Cloudflare --443--> Caddy --+--> /img/<hash>.webp  -> Azure Blob (read-only SAS)
#                               +--> /api/*, /*        -> app VM ${app_ip}:8080
#   app VM down               --> fallback page (or JSON for /api/*)
{
	# Origin cert is installed manually (Cloudflare Origin CA): no ACME, and
	# we define the :80 site ourselves so probes on port 80 are logged too.
	auto_https off
	default_sni ${site_host}

	servers {
		# Only these addresses may tell us the real client IP (Cloudflare edges).
		# Source: https://www.cloudflare.com/ips/ (re-check occasionally)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(access_log) {
	log {
		output file /var/log/caddy/access.json {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

http:// {
	import access_log
	redir https://${site_host}{uri} 308
}

https:// {
	import access_log
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Thumbnails: only GET/HEAD of exactly <2 hex>/<64 hex>.webp is allowed,
	# so the read token can't be used to fetch anything else.
	@thumb {
		method GET HEAD
		path_regexp ^/img/[0-9a-f]{2}/[0-9a-f]{64}\.webp$
	}
	handle @thumb {
		uri strip_prefix /img
		rewrite * /thumbs{path}?${read_sas}
		reverse_proxy https://${blob_host} {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_up -Authorization
			header_down -x-ms-*
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down Content-Type image/webp
		}
	}
	handle /img/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy ${app_ip}:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		# Phase 3: this goes through Anubis (127.0.0.1:8923) instead.
		reverse_proxy ${app_ip}:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"error":"app tier offline"}` 503
		}
		handle {
			root * /srv/fallback
			rewrite * /index.html
			file_server
		}
	}
}
