# /etc/searchbox/api.env on the app VM  (owner root, group searchbox, mode 0640)
# Double underscore = nested setting (SearchBox:Gemini:ApiKey).

# Read-only `api` role. Host is the Postgres private FQDN (terraform output -raw pg_fqdn).
SearchBox__Postgres=Host=pg-antiseo-xxxxx.postgres.database.azure.com;Database=antiseo;Username=api;Password=CHANGE_ME;SSL Mode=Require

# Upstash: Redis "TLS" URL from the Upstash console. Leave empty to run without Redis.
SearchBox__RedisUrl=rediss://default:CHANGE_ME@xxxx.upstash.io:6379

# AI summary through the Cloud Run relay (relay/README.md). Gemini refuses
# requests from Hong Kong, where this VM is, so don't point this at Google.
# ApiKey is the RELAY TOKEN, not the Gemini key. Leave it empty to switch the summary off.
# SearchBox__Gemini__Endpoint=https://gemini-relay-xxxxx.asia-south1.run.app/v1beta
SearchBox__Gemini__ApiKey=

# Exact model IDs: the same list you gave relay/deploy.sh.
# SearchBox__Gemini__Models__0__Id=gemini-3.5-flash-lite
# SearchBox__Gemini__Models__1__Id=gemma-4-26b-a4b-it

# Optional: the public Looker Studio EMBED URL (siem/DASHBOARD.md). When set, the
# header shows "Security dashboard", which opens /security.html with the report framed.
# SearchBox__DashboardUrl=https://lookerstudio.google.com/embed/reporting/<id>/page/<page>

SearchBox__ModelDir=/opt/searchbox/models/minilm
SearchBox__TrustedProxy=10.20.1.4
